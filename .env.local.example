NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Shared secret configured on the Sanity webhook that hits /api/revalidate.
SANITY_REVALIDATE_SECRET=

# Shared secret configured on the Sanity webhook(s) that hit /api/reindex.
SANITY_REINDEX_SECRET=

# Upstash Redis REST credentials backing API rate limit + cost cap guardrails.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anthropic API key powering chat runtime and guardrail calls.
ANTHROPIC_API_KEY=

# Voyage AI API key powering corpus chunk embeddings (voyage-4-lite, 512 dims).
VOYAGE_API_KEY=

# Upstash Vector REST credentials backing the corpus vector store.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
